package eventpgs

import (
	"github.com/freitasmatheusrn/social-fit/pkg/rest"
	"github.com/freitasmatheusrn/social-fit/pkg/form"
	"github.com/freitasmatheusrn/social-fit/internal/views"
	"fmt"
)

type FormFields struct{
	Title 			string
	PosterUrl 		string
	Description 	string
	Status 			string
	Start_date 		string
	End_date 		string
	City 			string
	Street 			string
	Neighbourhood 	string
	MaxCapacity 	int
}


templ EventForm(errs *rest.ApiErr, data FormFields){
	@views.DashboardBase() {
		<div class="max-w-4xl mx-auto">
			<div class="bg-white rounded-2xl shadow-xl p-8">
				<div class="mb-8">
					<h1 class="text-3xl font-bold text-gray-900">Criar Evento</h1>
					<p class="mt-2 text-sm text-gray-600">Preencha as informações do seu evento</p>
				</div>
				@Form(errs, FormFields{})		
				
			</div>
		</div>
	}
}

templ Form(errs *rest.ApiErr, data FormFields){
	<form 
		class="space-y-8" 
		hx-post="/dashboard/events/create_event" 
		hx-target="this"
		hx-swap="outerHTML"
	>
		<!-- Informações Básicas -->
		<div class="space-y-6">
			<h2 class="text-xl font-semibold text-gray-900 border-b pb-2">Informações Básicas</h2>
			<div>
				<label for="poster_url" class="block text-sm font-medium text-gray-700 mb-2">
					Poster do Evento
				</label>
				<input
					id="poster_url"
					name="poster_url"
					type="url"
					required
					value={ data.PosterUrl }
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "poster_url")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "poster_url")),
					}
					placeholder="Poster de divulgação do Evento"
				/>
				if form.HasFieldErrors(errs, "poster_url") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "poster_url") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
			
			<!-- Título -->
			<div>
				<label for="title" class="block text-sm font-medium text-gray-700 mb-2">
					Título do Evento
				</label>
				<input
					id="title"
					name="title"
					type="text"
					required
					value={ data.Title }
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "title")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "title")),
					}
					placeholder="Nome do seu evento"
				/>
				if form.HasFieldErrors(errs, "title") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "title") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
			
			<!-- Descrição -->
			<div>
				<label for="description" class="block text-sm font-medium text-gray-700 mb-2">
					Descrição
				</label>
				<textarea
					id="description"
					name="description"
					rows="4"
					required
					value={ data.Description }
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition duration-150 resize-none",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "description")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "description")),
					}
					placeholder="Descreva seu evento..."
				>{ data.Description }</textarea>
				if form.HasFieldErrors(errs, "description") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "description") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
			
			<!-- Status -->
			<div>
				<label for="status" class="block text-sm font-medium text-gray-700 mb-2">
					Status
				</label>
				<select
					id="status"
					name="status"
					required
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "status")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "status")),
					}
				>
					<option value="">Selecione o status</option>
					<option value="draft" selected?={ data.Status == "draft" }>Rascunho</option>
					<option value="published" selected?={ data.Status == "published" }>Publicado</option>
					<option value="cancelled" selected?={ data.Status == "cancelled" }>Cancelado</option>
				</select>
				if form.HasFieldErrors(errs, "status") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "status") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
			
			<!-- Capacidade Máxima -->
			<div>
				<label for="max_capacity" class="block text-sm font-medium text-gray-700 mb-2">
					Capacidade Máxima
				</label>
				<input
					id="max_capacity"
					name="max_capacity"
					type="number"
					required
					min="1"
					value={ fmt.Sprintf("%d", data.MaxCapacity) }
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "max_capacity")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "max_capacity")),
					}
					placeholder="Número máximo de participantes"
				/>
				if form.HasFieldErrors(errs, "max_capacity") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "max_capacity") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
		</div>
		
		<!-- Data e Horário -->
		<div class="space-y-6">
			<h2 class="text-xl font-semibold text-gray-900 border-b pb-2">Data e Horário</h2>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Data de Início -->
				<div>
					<label for="start_date" class="block text-sm font-medium text-gray-700 mb-2">
						Data e Hora de Início
					</label>
					<input
						id="start_date"
						name="start_date"
						type="datetime-local"
						required
						value={ data.Start_date }
						class={
							"appearance-none block w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
							templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "start_date")),
							templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "start_date")),
						}
					/>
					if form.HasFieldErrors(errs, "start_date") {
						<div class="mt-1 space-y-1">
							for _, fieldErr := range form.GetFieldErrors(errs, "start_date") {
								<p class="text-sm text-red-600">{ fieldErr.Message }</p>
							}
						</div>
					}
				</div>
				
				<!-- Data de Fim -->
				<div>
					<label for="end_date" class="block text-sm font-medium text-gray-700 mb-2">
						Data e Hora de Término
					</label>
					<input
						id="end_date"
						name="end_date"
						type="datetime-local"
						required
						value={ data.End_date }
						class={
							"appearance-none block w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
							templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "end_date")),
							templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "end_date")),
						}
					/>
					if form.HasFieldErrors(errs, "end_date") {
						<div class="mt-1 space-y-1">
							for _, fieldErr := range form.GetFieldErrors(errs, "end_date") {
								<p class="text-sm text-red-600">{ fieldErr.Message }</p>
							}
						</div>
					}
				</div>
			</div>
		</div>
		
		<!-- Localização -->
		<div class="space-y-6">
			<h2 class="text-xl font-semibold text-gray-900 border-b pb-2">Localização</h2>
			
			<!-- Cidade -->
			<div>
				<label for="city" class="block text-sm font-medium text-gray-700 mb-2">
					Cidade
				</label>
				<input
					id="city"
					name="city"
					type="text"
					required
					value={ data.City }
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "city")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "city")),
					}
					placeholder="Nome da cidade"
				/>
				if form.HasFieldErrors(errs, "city") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "city") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
			
			<!-- Bairro -->
			<div>
				<label for="neighbourhood" class="block text-sm font-medium text-gray-700 mb-2">
					Bairro
				</label>
				<input
					id="neighbourhood"
					name="neighbourhood"
					type="text"
					required
					value={ data.Neighbourhood }
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "neighbourhood")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "neighbourhood")),
					}
					placeholder="Nome do bairro"
				/>
				if form.HasFieldErrors(errs, "neighbourhood") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "neighbourhood") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
			
			<!-- Rua -->
			<div>
				<label for="street" class="block text-sm font-medium text-gray-700 mb-2">
					Rua
				</label>
				<input
					id="street"
					name="street"
					type="text"
					required
					value={ data.Street }
					class={
						"appearance-none block w-full px-4 py-3 border rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition duration-150",
						templ.KV("border-red-300 focus:ring-red-600", form.HasFieldErrors(errs, "street")),
						templ.KV("border-gray-300 focus:ring-purple-600", !form.HasFieldErrors(errs, "street")),
					}
					placeholder="Nome da rua e número"
				/>
				if form.HasFieldErrors(errs, "street") {
					<div class="mt-1 space-y-1">
						for _, fieldErr := range form.GetFieldErrors(errs, "street") {
							<p class="text-sm text-red-600">{ fieldErr.Message }</p>
						}
					</div>
				}
			</div>
		</div>
		
		<!-- Botões de Ação -->
		<div class="flex flex-col sm:flex-row gap-4 pt-6 border-t">
			<button
				type="button"
				onclick="window.history.back()"
				class="flex-1 py-3 px-4 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-600 transition duration-150"
			>
				Cancelar
			</button>
			<button
				type="submit"
				class="flex-1 flex justify-center items-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-600 transition duration-150 disabled:opacity-50"
				hx-indicator="#spinner"
			>
				<span id="button-text">Criar Evento</span>
				<span id="spinner" class="htmx-indicator ml-2">
					<svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
				</span>
			</button>
		</div>
	</form>
}