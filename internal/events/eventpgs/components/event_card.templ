package eventpgs

import (
	"fmt"
	"github.com/freitasmatheusrn/social-fit/internal/events/dtos"
)



templ EventCard(event dtos.EventCard) {
	<div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
		<!-- Status Badge -->
		<div class="p-4 pb-0">
			@StatusBadge(event.Status)
		</div>
		
		<!-- Card Content -->
		<div class="p-6 pt-3">
			<!-- Título -->
			<h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-1">
				{ event.Title }
			</h3>
					
			<!-- Info do Evento -->
			<div class="space-y-2 mb-4">
				<!-- Data -->
				<div class="flex items-center text-sm text-gray-500">
					<svg class="h-5 w-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					<span>{ event.StartDate }</span>
				</div>
				
				<!-- Capacidade -->
				<div class="flex items-center text-sm text-gray-500">
					<svg class="h-5 w-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
					</svg>
					<span>Até { fmt.Sprintf("%v", event.MaxCapacity) } participantes</span>
				</div>
			</div>
			
			<!-- Ações -->
			<div class="flex gap-2 pt-4 border-t border-gray-100">
				
				<a
					href={ templ.SafeURL(fmt.Sprintf("/dashboard/events/%s", event.ID)) }
					class="flex-1 text-center px-4 py-2 border border-purple-600 rounded-lg text-sm font-medium text-purple-600 hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-600 transition duration-150"
					>Ver Detalhes
				</a>
				
				<a
					href={ templ.SafeURL(fmt.Sprintf("/eventos/%s/editar", event.ID)) }
					class="flex-1 text-center px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-600 transition duration-150"
					>Editar
				</a>
			</div>
		</div>
	</div>
}

templ StatusBadge(status string) {
	if status == "published" {
		<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
			<svg class="h-2 w-2 mr-1.5 fill-current" viewBox="0 0 8 8">
				<circle cx="4" cy="4" r="3"></circle>
			</svg>
			Publicado
		</span>
	} else if status == "draft" {
		<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
			<svg class="h-2 w-2 mr-1.5 fill-current" viewBox="0 0 8 8">
				<circle cx="4" cy="4" r="3"></circle>
			</svg>
			Rascunho
		</span>
	} else if status == "cancelled" {
		<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
			<svg class="h-2 w-2 mr-1.5 fill-current" viewBox="0 0 8 8">
				<circle cx="4" cy="4" r="3"></circle>
			</svg>
			Cancelado
		</span>
	}
}