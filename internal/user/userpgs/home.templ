package userpgs

import "github.com/freitasmatheusrn/social-fit/internal/events/dtos"
import "github.com/freitasmatheusrn/social-fit/internal/events/eventpgs/components"

import (
	"github.com/freitasmatheusrn/social-fit/internal/views"
	
	)


templ Home(events []dtos.EventCard) {
	@views.DashboardBase() {
		<div class="space-y-6">
			<!-- Header -->
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-3xl font-bold text-gray-900">Meus Eventos</h1>
					<p class="mt-2 text-sm text-gray-600">Gerencie todos os seus eventos</p>
				</div>
				<div class="mt-4 sm:mt-0">
					
					<a	href="/dashboard/events/form"
						class="inline-flex items-center px-4 py-2 border 
						border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gradient-to-r 
						from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 
						focus:outline-none focus:ring-2 
						focus:ring-offset-2 focus:ring-purple-600 transition duration-150">
					
						<svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Novo Evento
					</a>
				</div>
			</div>
			
			<!-- Lista de Eventos ou Estado Vazio -->
			if len(events) == 0 {
				@EmptyState()
			} else {
				@eventpgs.EventsList(events)
			}
		</div>
	}
}

templ EmptyState() {
	<div class="bg-white rounded-2xl shadow-lg p-12 text-center">
		<div class="mx-auto h-24 w-24 bg-purple-100 rounded-full flex items-center justify-center mb-6">
			<svg class="h-12 w-12 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
			</svg>
		</div>
		<h2 class="text-2xl font-bold text-gray-900 mb-2">
			Nenhum evento criado
		</h2>
		<p class="text-gray-600 mb-8">
			Comece criando seu primeiro evento e compartilhe com seus participantes
		</p>
		<a
			href="/dashboard/events/form"
			class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-600 transition duration-150"
		>
			<svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
			</svg>
			Criar Primeiro Evento
		</a>
	</div>
}